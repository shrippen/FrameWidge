<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>

    <group name="General">
        <entry name="servicePort" type="Int">
            <label>Port of the framework-control service</label>
            <default>30912</default>
        </entry>
        <entry name="pollIntervalMs" type="Int">
            <label>Health poll interval in milliseconds</label>
            <default>2000</default>
        </entry>
        <entry name="compactDisplay" type="String">
            <label>What to show on the compact tray icon (temp, rpm, soc, icon)</label>
            <default>temp</default>
        </entry>
        <entry name="compactShowIcon" type="Bool">
            <label>Also show the plain icon alongside the data value on the compact tray icon (ignored when compactDisplay is "icon")</label>
            <default>false</default>
        </entry>
        <entry name="compactOverlayScale" type="Int">
            <label>Size of the data overlay on the compact tray icon, in percent of the default size (50-200)</label>
            <default>100</default>
        </entry>
        <!--
            Value->color bands for the overlay text, per display mode, stored
            as a JSON string for the same reason as fanCurvePresetsJson below
            (kcfg has no list-of-objects type). Schema:
            { "temp|rpm|soc": [ { "upTo": <number|null>, "color": <token|#rrggbb> }, ... ] }
            upTo is inclusive; the last band is always open-ended (null).
            Color tokens (positive/neutral/negative/text/disabled) resolve
            against the active Plasma color scheme at render time; anything
            else must be a #rrggbb literal. Keep this default in sync with
            ColorGrading.defaultOverlayBands().
        -->
        <entry name="compactOverlayBands" type="String">
            <label>JSON-encoded value-to-color bands for the tray overlay text, per display mode</label>
            <default>{"temp":[{"upTo":60,"color":"positive"},{"upTo":80,"color":"neutral"},{"upTo":null,"color":"negative"}],"rpm":[{"upTo":2500,"color":"positive"},{"upTo":4000,"color":"neutral"},{"upTo":null,"color":"negative"}],"soc":[{"upTo":20,"color":"negative"},{"upTo":50,"color":"neutral"},{"upTo":null,"color":"positive"}]}</default>
        </entry>
        <!--
            The backend service logs every HTTP request to the journal, so
            polling while the popup is closed is opt-in: default off keeps
            an idle tray widget from spamming the journal. Opening the
            popup always polls regardless.
        -->
        <entry name="debugBackgroundPolling" type="Bool">
            <label>Keep polling the service while the popup is closed (debug)</label>
            <default>false</default>
        </entry>
    </group>

    <group name="FanCurvePresets">
        <!--
            Saved fan curve presets, stored client-side rather than round-tripped
            through the framework-control backend's /api/config: that API is owned
            by an upstream project we don't control and don't extend (see
            DESIGN.md), so a "presets" field added to its fan.curve schema would
            either be silently dropped or rejected. A JSON-encoded string is the
            simplest way to store a variable-length list of named curves in kcfg,
            which has no native list-of-objects type.
        -->
        <entry name="fanCurvePresetsJson" type="String">
            <label>JSON-encoded array of saved fan curve presets</label>
            <default>[]</default>
        </entry>
    </group>
</kcfg>
